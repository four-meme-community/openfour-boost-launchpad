# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# ── Upstream (partner API; inject meme-api-key only, no RSA) ──
MEME_WEB_BASE_URL=https://four.meme
MEME_API_KEY=replace-with-your-meme-api-key
MEME_WEB_TIMEOUT_MS=30000

# meme-web market WS (BFF only; frontend uses /v1/stream/bars)
MEME_WS_URL=wss://ws.four.meme/ws

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Site branding (public /v1/config) ───────────────────────────
SITE_NAME=OpenFour Boost
SITE_TAGLINE=Launch meme tokens on your own brand
SITE_LOGO_URL=
SITE_PRIMARY_COLOR="#111111"

# ── Switchable chains (frontend reads GET /v1/config) ───────────
# Catalog keys: bsc, bsc-testnet, robinhood, robinhood-testnet
# Do not mix mainnet + testnet of the same family in one deploy.
ENABLED_CHAINS=bsc,robinhood
DEFAULT_CHAIN=bsc

# Per-chain OpenFour create preset IDs (frontend reads GET /v1/config).
# Format: key:id,id;key:id
# Keys: catalog (bsc) or family (bsc / robinhood). Catalog key wins.
CREATE_PRESETS=bsc:1778027615733;robinhood:1778027615741,1778027615742
