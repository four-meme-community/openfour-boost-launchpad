# Browser talks to BFF only; never put meme-api-key here
NEXT_PUBLIC_BFF_URL=http://localhost:8787

# PROD = BSC 56 / Robinhood 4663 mainnet
NEXT_PUBLIC_MODE=PROD

# OpenFour create fallback template (BSC). Per-chain presets come from BFF /v1/config.
NEXT_PUBLIC_OPEN_FOUR_TEMPLATE_ID=1778027615733

# Image CDN (meme-web file host; overridable via /v1/public/file/host)
NEXT_PUBLIC_FILE_HOST=https://static.four.meme

# ZapRouter (optional; omit to read OpenFourCore.zapRouter())
NEXT_PUBLIC_ZAP_ROUTER_ADDRESS=
# Zap debug logs (on by default when not PROD)
NEXT_PUBLIC_ZAP_DEBUG=

# Optional: override default public RPCs (comma-separated). Omit for built-in bnbchain/defibit/ninicoin list + fallback
# NEXT_PUBLIC_RPC_URLS=https://bsc-dataseed.bnbchain.org/,https://bsc-rpc.publicnode.com

# Optional: override Robinhood Chain (4663) public RPCs
# NEXT_PUBLIC_ROBINHOOD_RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://robinhood-rpc.publicnode.com
